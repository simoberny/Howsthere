<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@android:color/black">
    <androidx.camera.view.PreviewView
        android:id="@+id/ar_camera"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:importantForAccessibility="no" />
    <it.howsthere.howsthere2.ui.result.ArOverlayView
        android:id="@+id/ar_overlay"
        android:layout_width="match_parent" android:layout_height="match_parent" />
    <FrameLayout android:id="@+id/ar_chrome"
        android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:id="@+id/ar_header"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="top" android:layout_margin="12dp"
            android:padding="8dp" android:gravity="center_vertical"
            android:background="@drawable/ar_panel_background" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/ar_close"
                style="@style/Widget.Material3Expressive.Button.IconButton.Tonal"
                android:layout_width="48dp" android:layout_height="48dp"
                android:contentDescription="@string/ar_close"
                app:icon="@drawable/baseline_arrow_back_ios_24" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                <TextView android:id="@+id/ar_title"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="@android:color/white"
                    android:accessibilityHeading="true" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/ar_profile_legend" android:textColor="#64F0E4"
                        android:textAppearance="?attr/textAppearanceLabelMedium" />
                    <TextView android:id="@+id/ar_trajectory_legend"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" android:textColor="#FFD45A"
                        android:textAppearance="?attr/textAppearanceLabelMedium" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/ar_footer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="bottom" android:layout_margin="12dp"
            android:padding="12dp" android:orientation="vertical"
            android:background="@drawable/ar_panel_background">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/ar_status"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="12dp"
                    android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@android:color/white"
                    android:accessibilityLiveRegion="polite" />
                <com.google.android.material.button.MaterialButton android:id="@+id/ar_align"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/ar_align" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/ar_retry"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/ar_retry" android:visibility="gone" />
            <LinearLayout android:id="@+id/ar_alignment"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:visibility="gone" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:baselineAligned="false">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/ar_heading" android:labelFor="@id/ar_heading"
                            android:textAppearance="?attr/textAppearanceLabelMedium" />
                        <com.google.android.material.slider.Slider android:id="@+id/ar_heading"
                            android:layout_width="match_parent" android:layout_height="48dp"
                            android:valueFrom="-45" android:valueTo="45" android:stepSize="1"
                            android:contentDescription="@string/ar_heading" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/ar_altitude" android:labelFor="@id/ar_altitude"
                            android:textAppearance="?attr/textAppearanceLabelMedium" />
                        <com.google.android.material.slider.Slider android:id="@+id/ar_altitude"
                            android:layout_width="match_parent" android:layout_height="48dp"
                            android:valueFrom="-20" android:valueTo="20" android:stepSize="1"
                            android:contentDescription="@string/ar_altitude" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/ar_scale" android:labelFor="@id/ar_scale"
                            android:textAppearance="?attr/textAppearanceLabelMedium" />
                        <com.google.android.material.slider.Slider android:id="@+id/ar_scale"
                            android:layout_width="match_parent" android:layout_height="48dp"
                            android:valueFrom="0.7" android:valueTo="1.3" android:value="1"
                            android:contentDescription="@string/ar_scale" />
                    </LinearLayout>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/ar_reset"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="end" android:text="@string/ar_reset" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
