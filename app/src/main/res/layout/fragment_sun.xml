<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context="it.howsthere.howsthere2.ui.result.SunFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="5dp"
            app:layout_collapseMode="pin">

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/chart"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_centerHorizontal="true"
                android:paddingTop="15dp"
                app:layout_collapseMode="parallax" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/N"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="N"
                    android:textColor="@color/md_theme_error"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/E"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="E"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/S"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/O"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="O"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/N2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="N"
                    android:textColor="@color/md_theme_error"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:layout_marginTop="32dp">

                <LinearLayout
                    android:id="@+id/timeline_bar"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"> <!-- Sfondo per la barra -->

                    <!-- Crepuscolo -->
                    <View
                        android:id="@+id/twilight"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="15"
                        android:background="#4A90E2" /> <!-- Colore blu chiaro -->

                    <!-- Alba -->
                    <View
                        android:id="@+id/sunrise"
                        android:layout_width="5dp"
                        android:layout_height="match_parent"
                        android:background="@color/md_theme_background" /> <!-- Colore arancione chiaro -->

                    <!-- Golden Hour -->
                    <View
                        android:id="@+id/day_hour"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="70"
                        android:background="#FFC107" /> <!-- Colore giallo -->

                    <!-- Tramonto -->
                    <View
                        android:id="@+id/sunset"
                        android:layout_width="5dp"
                        android:layout_height="match_parent"
                        android:background="@color/md_theme_background" /> <!-- Colore arancione scuro -->

                    <!-- Crepuscolo serale -->
                    <View
                        android:id="@+id/evening_twilight"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="15"
                        android:background="#4A90E2" /> <!-- Stesso colore del crepuscolo -->
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/timeline_now"
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/left_now"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="50"
                        android:alpha="0"
                        android:background="@android:color/transparent" />

                    <View
                        android:id="@+id/bar_now"
                        android:layout_width="8dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/border" />

                    <View
                        android:id="@+id/right_now"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="50"
                        android:alpha="0"
                        android:background="@android:color/transparent" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/timeline_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal"> <!-- Sfondo per la barra -->

                <!-- Crepuscolo -->
                <View
                    android:id="@+id/morning_padding"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="15" /> <!-- Colore blu chiaro -->

                <!-- Alba -->
                <TextView
                    android:id="@+id/sunrise_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="06:00"
                    android:textColor="@color/md_theme_onBackground"
                    android:textSize="12sp" />

                <!-- Golden Hour -->
                <View
                    android:id="@+id/day_padding"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="70" /> <!-- Colore giallo -->

                <!-- Tramonto -->
                <TextView
                    android:id="@+id/sunset_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="06:00"
                    android:textColor="@color/md_theme_onBackground"
                    android:textSize="12sp" />

                <!-- Crepuscolo serale -->
                <View
                    android:id="@+id/evening_padding"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="15" /> <!-- Stesso colore del crepuscolo -->
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="16dp"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:layout_gravity="center_vertical"
                                    android:src="@drawable/sunrise" />

                                <!--<TextView
                                    android:id="@+id/sunrise_utc"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:text="UTC"
                                    android:textAlignment="textEnd"
                                    android:textSize="8sp" />-->
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingBottom="8dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="1"
                                    android:text="@string/sunrise"
                                    android:textSize="16sp"
                                    android:textStyle="normal" />

                                <TextView
                                    android:id="@+id/sunrise_time"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_margin="0dp"
                                    android:layout_weight="2"
                                    android:text="00:00"
                                    android:textAlignment="textEnd"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingBottom="8dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="1"
                                    android:text="@string/horizon"
                                    android:textSize="13sp"
                                    android:textStyle="normal" />

                                <TextView
                                    android:id="@+id/horizon_sunrise"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_margin="0dp"
                                    android:layout_weight="2"
                                    android:text="00:00"
                                    android:textAlignment="textEnd"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingBottom="8dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="1"
                                    android:text="@string/azimut"
                                    android:textSize="13sp"
                                    android:textStyle="normal" />

                                <TextView
                                    android:id="@+id/azimut_sunrise"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_margin="0dp"
                                    android:layout_weight="2"
                                    android:text="00:00"
                                    android:textAlignment="textEnd"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/timeline_rises"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clipToPadding="false"
                                android:scrollbars="vertical"
                                android:visibility="gone" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/md_theme_surfaceContainerHighest"
                                android:layout_marginVertical="12dp"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="1"
                                    android:text="@string/blue_hour"
                                    android:textAppearance="?attr/textAppearanceTitleMedium"
                                    android:textSize="14sp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/blue_rise_start"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="3dp"
                                        android:layout_weight="2"
                                        android:text="00:00"
                                        android:textAlignment="center"
                                        android:textSize="13sp"/>

                                    <TextView
                                        android:id="@+id/blue_rise_end"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="3dp"
                                        android:layout_weight="2"
                                        android:text="00:00"
                                        android:textAlignment="center"
                                        android:textSize="13sp"/>
                                </LinearLayout>
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/md_theme_surfaceContainerHighest"
                                android:layout_marginVertical="12dp"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="1"
                                    android:text="@string/golden_hour"
                                    android:textAppearance="?attr/textAppearanceTitleMedium"
                                    android:textSize="14sp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/golden_rise_start"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="3dp"
                                        android:layout_weight="2"
                                        android:text="00:00"
                                        android:textAlignment="center"
                                        android:textSize="13sp" />

                                    <TextView
                                        android:id="@+id/golden_rise_end"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="3dp"
                                        android:layout_weight="2"
                                        android:text="00:00"
                                        android:textAlignment="center"
                                        android:textSize="13sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <Button
                                android:id="@+id/save_sunrise"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:layout_marginTop="16dp"
                                android:backgroundTint="@color/md_theme_secondary"
                                android:text="@string/save_cal"
                                android:textSize="12sp"
                                android:visibility="visible"
                                app:icon="@drawable/baseline_notification_add_24" />
                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="16dp"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:layout_gravity="center_vertical"
                                    android:src="@drawable/sunset" />

                                <!--<TextView
                                    android:id="@+id/sunset_utc"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:text="UTC"
                                    android:textAlignment="textEnd"
                                    android:textSize="8sp" />-->
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingBottom="8dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="1"
                                    android:text="@string/sunset"
                                    android:textSize="16sp"
                                    android:textStyle="normal" />

                                <TextView
                                    android:id="@+id/sunset_time"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_margin="0dp"
                                    android:layout_weight="2"
                                    android:text="00:00"
                                    android:textAlignment="textEnd"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingBottom="8dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="1"
                                    android:text="@string/horizon"
                                    android:textSize="13sp"
                                    android:textStyle="normal" />

                                <TextView
                                    android:id="@+id/horizon_sunset"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_margin="0dp"
                                    android:layout_weight="2"
                                    android:text="00:00"
                                    android:textAlignment="textEnd"
                                    android:textSize="14sp" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingBottom="8dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="1"
                                    android:text="@string/azimut"
                                    android:textSize="13sp"
                                    android:textStyle="normal" />

                                <TextView
                                    android:id="@+id/azimut_sunset"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_margin="0dp"
                                    android:layout_weight="2"
                                    android:text="00:00"
                                    android:textAlignment="textEnd"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/timeline_sets"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clipToPadding="false"
                                android:scrollbars="vertical"
                                android:visibility="gone" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/md_theme_surfaceContainerHighest"
                                android:layout_marginVertical="12dp"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="1"
                                    android:text="@string/golden_hour"
                                    android:textAppearance="?attr/textAppearanceTitleMedium"
                                    android:textSize="14sp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/golden_set_start"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="3dp"
                                        android:layout_weight="2"
                                        android:text="00:00"
                                        android:textAlignment="center"
                                        android:textSize="13sp" />

                                    <TextView
                                        android:id="@+id/golden_set_end"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="3dp"
                                        android:layout_weight="2"
                                        android:text="00:00"
                                        android:textAlignment="center"
                                        android:textSize="13sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/md_theme_surfaceContainerHighest"
                                android:layout_marginVertical="12dp"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="1"
                                    android:text="@string/blue_hour"
                                    android:textAppearance="?attr/textAppearanceTitleMedium"
                                    android:textSize="14sp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/blue_set_start"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="3dp"
                                        android:layout_weight="2"
                                        android:text="00:00"
                                        android:textAlignment="center"
                                        android:textSize="13sp" />

                                    <TextView
                                        android:id="@+id/blue_set_end"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="3dp"
                                        android:layout_weight="2"
                                        android:text="00:00"
                                        android:textAlignment="center"
                                        android:textSize="13sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <Button
                                android:id="@+id/save_sunset"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:layout_marginTop="16dp"
                                android:backgroundTint="@color/md_theme_secondary"
                                android:text="@string/save_cal"
                                android:textSize="12sp"
                                android:visibility="visible"
                                app:icon="@drawable/baseline_notification_add_24" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="16dp"
                                android:text="@string/sun_times"
                                android:textAppearance="?attr/textAppearanceTitleMedium" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingBottom="8dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="1"
                                    android:text="@string/horizon"
                                    android:textSize="13sp"
                                    android:textStyle="normal" />

                                <TextView
                                    android:id="@+id/sun_time"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_margin="0dp"
                                    android:layout_weight="2"
                                    android:text="00:00"
                                    android:textAlignment="textEnd"
                                    android:textSize="14sp" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingBottom="8dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_weight="1"
                                    android:text="@string/with_peaks"
                                    android:textSize="13sp"
                                    android:textStyle="normal" />

                                <TextView
                                    android:id="@+id/sun_time_mountains"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_margin="0dp"
                                    android:layout_weight="2"
                                    android:text="00:00"
                                    android:textAlignment="textEnd"
                                    android:textSize="14sp" />

