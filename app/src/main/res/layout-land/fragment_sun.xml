<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/md_theme_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/chart_header_background" android:layout_marginHorizontal="8dp" android:layout_marginTop="0dp" android:paddingHorizontal="12dp" android:paddingVertical="4dp">
        <TextView android:id="@+id/peaks_count" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:layout_marginEnd="12dp" android:textSize="14sp" android:textColor="@color/md_theme_secondary" android:textStyle="bold" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mountain" android:textColor="@color/md_theme_onBackground" android:drawableStart="@drawable/legend_mountain" android:drawablePadding="6dp" android:layout_marginStart="12dp" android:textSize="14sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/sole" android:textColor="@color/md_theme_onBackground" android:drawableStart="@drawable/legend_sun" android:drawablePadding="6dp" android:layout_marginStart="12dp" android:textSize="14sp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton style="@style/Widget.Material3Expressive.Button.IconButton.Tonal" android:id="@+id/open_ar" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:contentDescription="@string/ar_open" app:icon="@drawable/ic_ar_camera" />
    </LinearLayout>
    <it.howsthere.howsthere2.ui.result.PanoramaLineChart android:id="@+id/chart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <it.howsthere.howsthere2.ui.result.DirectionStrip android:id="@+id/direction_strip" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="4dp" />
</LinearLayout>
